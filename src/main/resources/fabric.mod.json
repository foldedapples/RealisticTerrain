{
  "schemaVersion": 1,
  "id": "realisticterrain",
  "version": "${version}",
  "name": "Realistic Terrain",
  "description": "Large-scale erosion-inspired mountains, valleys, rivers and coastlines with a configurable world preset.",
  "authors": ["cokedoutsnail"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.cokedoutsnail.realisticterrain.RealisticTerrainMod"],
    "client": ["com.cokedoutsnail.realisticterrain.RealisticTerrainClient"]
  },
  "mixins": [
    {
      "config": "realisticterrain.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
